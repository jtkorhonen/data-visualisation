# Nature-oriented starting style for the Visualisation skill.
#
# Based on the Nature Research Figure Guide conventions recorded in the local
# scientific-visualization skill snapshot (reviewed 2026-10-01): 89 mm single-column,
# 120–136 mm intermediate, 183 mm full-width, maximum height 247 mm, 5–7 pt ordinary
# text, 8 pt lowercase bold upright panel labels, and editable vector text.
# This is a practical starting point, not a declaration of current journal compliance.
# Verify the live guide before submission.
# Panel labels and final panel geometry are intentionally script/layout concerns.

figure.dpi: 100
figure.figsize: 3.503937, 2.625
figure.facecolor: white
figure.constrained_layout.use: False

font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 7
font.weight: normal
axes.prop_cycle: cycler('color', ['black'])
mathtext.fontset: dejavusans

axes.linewidth: 0.5
axes.edgecolor: black
axes.axisbelow: True
axes.grid: False
axes.spines.top: False
axes.spines.right: False
axes.labelsize: 7
axes.labelweight: normal
axes.titlesize: 7
axes.titleweight: normal
axes.titlepad: 8
yaxis.labellocation: top

xtick.labelsize: 6
ytick.labelsize: 6
xtick.major.size: 2.5
xtick.minor.size: 1.5
ytick.major.size: 2.5
ytick.minor.size: 1.5
xtick.major.width: 0.5
xtick.minor.width: 0.5
ytick.major.width: 0.5
ytick.minor.width: 0.5
xtick.direction: out
ytick.direction: out

lines.linewidth: 1.0
lines.markersize: 3
lines.markeredgewidth: 0.4
patch.linewidth: 0.25

legend.fontsize: 6
legend.frameon: False
figure.titlesize: 8

# Keep raster exports suitable for Nature-style image-containing artwork. Scripts
# may override this explicitly when a project has a different documented contract.
savefig.dpi: 450
savefig.facecolor: white
savefig.edgecolor: white
savefig.transparent: False
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
image.cmap: viridis
