# Snakemake workflow: turns inputs/ into derived tables and figures under outputs/.
# Rules call R scripts with quoted paths so project paths may contain spaces; renv supplies the packages.

configfile: "config.yaml"

ALLOWED_PNG_DPI = (450, 600)
if config["png_dpi"] not in ALLOWED_PNG_DPI:
    raise ValueError(f"png_dpi must be one of {ALLOWED_PNG_DPI}, got {config['png_dpi']!r}")

# The project's .Rprofile activates renv; site-wide profiles and environment files are skipped
# so that only files inside the project can change the output.
RSCRIPT = "Rscript --no-site-file --no-environ"
STYLE = config["style"]
FIGURE_HELPERS = "scripts/figure_style.R"
DATA_LOADER = "scripts/summarise.R"
FIGURE_ARGS = (
    "--style {input.style:q} --png {output.png:q} --svg {output.svg:q} "
    "--dpi {params.dpi} --width-mm {params.width_mm} --height-mm {params.height_mm}"
)


rule all:
    input:
        "outputs/data/summary.csv",
        multiext("outputs/figures/measurement_by_day", ".png", ".svg"),
        multiext("outputs/figures/measurement_distribution", ".png", ".svg"),


rule summarise:
    input:
        data="inputs/measurements.csv",
        script="scripts/summarise.R",
        lock="renv.lock",
    output:
        "outputs/data/summary.csv",
    shell:
        RSCRIPT + " {input.script:q} --data {input.data:q} --output {output:q}"


rule plot_measurement_by_day:
    input:
        data="inputs/measurements.csv",
        script="scripts/plot_measurement_by_day.R",
        helpers=FIGURE_HELPERS,
        loader=DATA_LOADER,
        style=STYLE,
        lock="renv.lock",
    output:
        png="outputs/figures/measurement_by_day.png",
        svg="outputs/figures/measurement_by_day.svg",
    params:
        dpi=config["png_dpi"],
        width_mm=config["figure_width_mm"],
        height_mm=config["figure_height_mm"],
    shell:
        RSCRIPT + " {input.script:q} --data {input.data:q} " + FIGURE_ARGS


rule plot_measurement_distribution:
    input:
        data="inputs/measurements.csv",
        script="scripts/plot_measurement_distribution.R",
        helpers=FIGURE_HELPERS,
        loader=DATA_LOADER,
        style=STYLE,
        lock="renv.lock",
    output:
        png="outputs/figures/measurement_distribution.png",
        svg="outputs/figures/measurement_distribution.svg",
    params:
        dpi=config["png_dpi"],
        width_mm=config["figure_width_mm"],
        height_mm=config["figure_height_mm"],
    shell:
        RSCRIPT + " {input.script:q} --data {input.data:q} " + FIGURE_ARGS
